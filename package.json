{
  "name": "vela-harness",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test:hooks": "node --import ./packages/agent/test/register-ts.mjs --experimental-transform-types --experimental-test-module-mocks --test packages/agent/test/hooks-service.test.ts packages/agent/test/hooks-runtime.test.ts apps/desktop/test/hooks-host.test.ts apps/desktop/test/settings-registry.test.ts packages/workspace/test/git-service.test.ts",
    "test:hooks:ui": "node apps/desktop/test/hooks-ui.mjs",
    "test:plugins": "pnpm --filter @vela/agent test:plugins && pnpm --filter @vela/desktop test:plugins && pnpm --filter @vela/desktop test:plugins:ui",
    "postinstall": "node node_modules/electron/install.js && node scripts/brand-electron-dev.mjs && node scripts/fix-native-modules.mjs",
    "dev": "pnpm --filter @vela/desktop dev",
    "build": "pnpm --filter @vela/desktop build",
    "package:mac": "pnpm --filter @vela/desktop dist:mac",
    "sign:release": "node scripts/sign-release.mjs",
    "update:keygen": "node scripts/update-keygen.mjs",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:market",
    "test": "pnpm typecheck && pnpm test:unit",
    "test:unit": "pnpm -r --if-present test && pnpm test:market",
    "test:ui": "pnpm --filter @vela/desktop test:ui",
    "test:smoke": "pnpm build && pnpm --filter @vela/desktop test:smoke",
    "test:mcp": "pnpm --filter @vela/agent test:mcp && pnpm --filter @vela/desktop test:mcp && pnpm --filter @vela/desktop test:mcp:ui && pnpm --filter @vela/desktop test:mcp:electron",
    "test:center": "pnpm --filter @vela/desktop test:center",
    "runner": "pnpm build:runner && node apps/runner/out/cli.mjs",
    "build:runner": "pnpm --filter @vela/runner-cli build",
    "test:runner": "pnpm --filter @vela/agent test:runner && pnpm --filter @vela/runner test && pnpm --filter @vela/runner-cli test",
    "market:keygen": "node --experimental-transform-types services/skill-market/scripts/keygen.ts",
    "market:build": "node --experimental-transform-types services/skill-market/scripts/build.ts",
    "test:market": "node --import ./packages/agent/test/register-ts.mjs --experimental-transform-types --test 'services/skill-market/test/*.test.ts'",
    "typecheck:market": "tsc -p services/skill-market/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
