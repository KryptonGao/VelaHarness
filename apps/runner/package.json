{
  "name": "@vela/runner-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless, single-shot Vela task runner for scripts and CI",
  "bin": {
    "vela-runner": "./out/cli.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ../../packages/agent/test/register-ts.mjs --experimental-transform-types --experimental-test-module-mocks --test 'test/*.test.ts'"
  },
  "dependencies": {
    "@vela/runner": "workspace:*",
    "@vela/shared": "workspace:*"
  }
}
